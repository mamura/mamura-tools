{
  "name": "component-generator",
  "displayName": "Mamura Tools",
  "description": "Ferramentas para acelerar o desenvolvimento | React | Laravel | Symfony",
  "author": {
    "name": "Mamura",
    "url": "https://mamura.dev"
  },
  "homepage": "https://github.com/mamura/mamura-tools#readme",
  "icon": "resources/icon.png",
  "bugs": {
      "url": "https://github.com/mamura/mamura-tools/issues"
  },
  "repository": {
      "type": "git",
      "url": "https://github.com/mamura/mamura-tools.git"
  },
  "license": "MIT",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mamuraTools.createReactComponent",
        "title": "Criar componente React",
        "category": "Mamura Tools",
        "icon": "$(new-folder)"
      }
    ],
    "submenus": [
      {
        "id": "mamuraTools.menu",
        "label": "Mamura Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "mamuraTools.menu",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "mamuraTools.menu": [
        {
          "command": "mamuraTools.createReactComponent",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "vsce package",
    "package:vsix:pre-release": "vsce package --pre-release"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
